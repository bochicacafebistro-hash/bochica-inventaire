rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// Règles Firestore — Bochica Inventaire
// ───────────────────────────────────────────────────────────────
// Ces règles protègent l'accès aux données par rôle côté serveur
// (vérifié par Firebase avant toute lecture/écriture).
//
// Prérequis : chaque utilisateur authentifié doit avoir un doc
// /users/{uid} avec un champ `role` ∈ {"global_admin", "chef", "employee"}
//
// À appliquer dans la Console Firebase :
//   Firestore → Règles → Coller ce contenu → Publier
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userRole() {
      return userDoc().role;
    }
    function isAdmin()     { return isAuthed() && userRole() == "global_admin"; }
    function isChef()      { return isAuthed() && userRole() == "chef"; }
    function isEmployee()  { return isAuthed() && userRole() == "employee"; }

    // Chef a accès à : inventaire, menu, ingrédients, recettes (lecture + écriture)
    function isChefOrAdmin() { return isAdmin() || isChef(); }

    // Employee a accès à : inventaire uniquement (écriture du stock)
    function canReadInventory()  { return isAuthed(); } // tous les connectés peuvent lire le stock
    function canWriteInventory() { return isAuthed(); } // tous peuvent mettre à jour le stock

    // ── /users/{uid} : profils utilisateurs (rôles) ──
    // Chaque user peut lire son propre profil. Seul l'admin peut modifier les rôles.
    match /users/{uid} {
      allow read: if isAuthed() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── /products : inventaire ────────────────────────
    match /products/{doc=**} {
      allow read:  if canReadInventory();
      allow write: if canWriteInventory();
    }

    // ── /settings : paramètres globaux (categories, schedule) ──
    match /settings/{doc=**} {
      allow read:  if isAuthed();
      allow write: if isChefOrAdmin();
    }

    // ── /suppliers : fournisseurs ─────────────────────
    match /suppliers/{doc=**} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── /employees : fiches employés + shifts ─────────
    match /employees/{doc=**} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── /tasks : Kanban tâches ────────────────────────
    match /tasks/{doc=**} {
      allow read:  if isAuthed();
      // Tous peuvent changer le statut d'une tâche ; admin seul peut créer/supprimer
      allow create, delete: if isAdmin();
      allow update: if isAuthed();
    }

    // ── /dailyTasks : tâches du jour (v3.36.0) ────────
    // Définies par l'admin (titre, type), cochées par les employés sur
    // l'accueil. Lecture par tous les authentifiés. Création/suppression et
    // modification du contenu (titre, type, ordre) = admin only. Les non-admin
    // peuvent UNIQUEMENT changer l'état de complétion (champs ci-dessous), ce
    // qui permet à un employé de cocher une tâche sans pouvoir l'éditer.
    match /dailyTasks/{doc=**} {
      allow read:   if isAuthed();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthed() && _dailyTaskToggleOnly());
    }
    function _dailyTaskToggleOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['done', 'doneAt', 'doneDate', 'doneBy', 'lastCompletedDate', 'lastCompletedBy', 'updatedAt']);
    }

    // ── /dailyChecklistState : complétion ouverture/fermeture par jour (v3.36.2) ──
    // Un doc par jour (id = "YYYY-MM-DD") qui n'enregistre QUE l'état coché des
    // items d'ouverture/fermeture. Réinitialisé naturellement chaque jour (nouveau
    // doc). Tous les rôles authentifiés peuvent cocher (lecture + écriture).
    match /dailyChecklistState/{doc=**} {
      allow read:  if isAuthed();
      allow write: if isAuthed();
    }

    // ── /menu : items du menu ─────────────────────────
    match /menu/{doc=**} {
      allow read:  if isAuthed();
      allow write: if isChefOrAdmin();
    }

    // ── /ingredients : ingrédients (food cost) ────────
    match /ingredients/{doc=**} {
      allow read:  if isAuthed();
      allow write: if isChefOrAdmin();
    }

    // ── /recipes : livre de cuisine ───────────────────
    match /recipes/{doc=**} {
      allow read:  if isAuthed();
      allow write: if isChefOrAdmin();
    }

    // ── /shoppingList : liste d'ingrédients (commandes / approvisionnement) ──
    // Items simples (nom, fournisseur, catégorie, notes) — accès admin + chef
    match /shoppingList/{doc=**} {
      allow read:  if isAuthed();
      allow write: if isChefOrAdmin();
    }

    // ── /events : événements du calendrier ──
    // Réservations privées, soirées spéciales, jours fériés, événements internes
    // (nom, date, heure, type, statut, capacité, contact, notes) — accès admin + chef
    match /events/{doc=**} {
      allow read:  if isAuthed();
      allow write: if isChefOrAdmin();
    }

    // ── /quotes : soumissions / devis pour clients ──
    // Données financières + contacts clients — admin uniquement
    match /quotes/{doc=**} {
      allow read, write: if isAdmin();
    }

    // ── /invoices : factures (v3.33.0) ──
    // Données financières + contacts clients — admin uniquement
    match /invoices/{doc=**} {
      allow read, write: if isAdmin();
    }

    // ── /quoteTemplates : forfaits par défaut (offres tarifaires) ──
    // Lecture admin + chef (le chef peut voir les forfaits offerts),
    // écriture admin uniquement
    match /quoteTemplates/{doc=**} {
      allow read:  if isChefOrAdmin();
      allow write: if isAdmin();
    }

    // ── /payroll : salaires + pourboires hebdomadaires ──
    // Un doc par semaine ISO (ex: "2026-W18") avec heures réelles, fenêtres
    // de service, total pourboires.
    //
    // v3.17.0 — Pointage : la page Pointage (kiosque PIN) doit pouvoir écrire
    // les heures d'entrée/sortie depuis un compte non-admin (typiquement la
    // tablette est loggée en "Employe"). On élargit donc :
    //   - lecture : tous les rôles authentifiés (pour que la page Pointage
    //     puisse détecter si une entrée a déjà été pointée aujourd'hui)
    //   - écriture restreinte : tout user authentifié peut créer ou mettre à
    //     jour un doc payroll, MAIS uniquement avec les champs `actualShifts`
    //     + meta techniques (weekId, weekStart, updatedAt). Pas de touche aux
    //     pourboires, multiplicateurs, verrouillage, etc. → ces champs et la
    //     suppression restent admin only.
    //   - admin garde l'accès complet (lecture + écriture sans restriction).
    match /payroll/{doc=**} {
      allow read:   if isAuthed();
      allow write:  if isAdmin();                                   // admin = tout
      allow create: if isAuthed() && _payrollPunchCreateOnly();     // non-admin : create restreint
      allow update: if isAuthed() && _payrollPunchUpdateOnly();     // non-admin : update restreint
      allow delete: if isAdmin();                                   // suppression admin only
    }

    // Pour un CREATE : le nouveau doc ne doit contenir QUE les champs autorisés
    // pour le pointage (actualShifts + meta techniques). Bloque toute tentative
    // d'un employé de pré-remplir des pourboires, un verrouillage, etc.
    function _payrollPunchCreateOnly() {
      return request.resource.data.keys()
        .hasOnly(['actualShifts', 'weekId', 'weekStart', 'updatedAt']);
    }

    // Pour un UPDATE : seules ces clés peuvent changer entre l'ancien et le
    // nouveau doc. Préserve les autres champs admin (locked, tipsByDay, etc.)
    // tels qu'ils sont, même si la requête tente de les écraser.
    function _payrollPunchUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['actualShifts', 'weekId', 'weekStart', 'updatedAt']);
    }

    // ── /payrollSimulations : scénarios paie hypothétiques (admin seul) ──
    // Snapshot figé du planifié + version modifiable pour planifier des
    // changements RH (embauche, hausse de taux, restructuration). Contient
    // données financières + identité employés → admin uniquement.
    match /payrollSimulations/{doc=**} {
      allow read, write: if isAdmin();
    }

    // ── /monthlyReports : rapports mensuels Cluster (admin seul) ──
    // Un doc par mois (id = "YYYY-MM"). Contient ventes, paiements, top
    // catégories/articles, heures, corrections. Source : PDFs Cluster parsés.
    match /monthlyReports/{doc=**} {
      allow read, write: if isAdmin();
    }

    // ── /expenses, /revenues, /expenseCategories,
    //    /fixedExpenseTemplates : finances (admin seul) ──
    match /expenses/{doc=**} {
      allow read, write: if isAdmin();
    }
    match /revenues/{doc=**} {
      allow read, write: if isAdmin();
    }
    match /expenseCategories/{doc=**} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }
    match /fixedExpenseTemplates/{doc=**} {
      allow read, write: if isAdmin();
    }

    // ── /logs : historique (lecture authentifiée, écriture par app) ──
    match /logs/{doc=**} {
      allow read:  if isAuthed();
      allow create: if isAuthed();  // toutes les actions logguées
      allow update, delete: if isAdmin();
    }

    // ── Refus par défaut ──────────────────────────────
    // Si une collection inconnue est ajoutée par erreur, elle est refusée.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
