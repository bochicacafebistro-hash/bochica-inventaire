# Optionnel — les valeurs par défaut (projet Firebase bochica-inventaire) sont
# dans src/core/firebase.ts. La config web Firebase n'est pas un secret :
# la sécurité repose sur firestore.rules. Surcharger ici pour pointer vers
# un autre projet (ex. un projet de test ou celui d'un futur client).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL de l'ancienne app, pour les modules pas encore migrés
VITE_LEGACY_APP_URL=https://bochica-inventaire.vercel.app
